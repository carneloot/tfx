{
  "name": "tfx",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": [],
  "engines": {
    "node": ">=24 <25",
    "bun": "1.3.14"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Telegram": "./src/Telegram.ts",
    "./TelegramError": "./src/TelegramError.ts",
    "./TelegramSchemas": "./src/TelegramSchemas.ts",
    "./Bot": "./src/Bot.ts",
    "./BotGroup": "./src/BotGroup.ts",
    "./Command": "./src/Command.ts",
    "./CommandInput": "./src/CommandInput.ts",
    "./BotBuilder": "./src/BotBuilder.ts",
    "./Middleware": "./src/Middleware.ts",
    "./UpdateContext": "./src/UpdateContext.ts",
    "./MessageContext": "./src/MessageContext.ts",
    "./CallbackQueryContext": "./src/CallbackQueryContext.ts",
    "./InlineKeyboard": "./src/InlineKeyboard.ts",
    "./ReplyKeyboard": "./src/ReplyKeyboard.ts",
    "./CallbackData": "./src/CallbackData.ts"
  },
  "files": [
    "dist",
    "src/internal/telegram/generated"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./Telegram": "./dist/Telegram.js",
      "./TelegramError": "./dist/TelegramError.js",
      "./TelegramSchemas": "./dist/TelegramSchemas.js",
      "./Bot": "./dist/Bot.js",
      "./BotGroup": "./dist/BotGroup.js",
      "./Command": "./dist/Command.js",
      "./CommandInput": "./dist/CommandInput.js",
      "./BotBuilder": "./dist/BotBuilder.js",
      "./Middleware": "./dist/Middleware.js",
      "./UpdateContext": "./dist/UpdateContext.js",
      "./MessageContext": "./dist/MessageContext.js",
      "./CallbackQueryContext": "./dist/CallbackQueryContext.js",
      "./InlineKeyboard": "./dist/InlineKeyboard.js",
      "./ReplyKeyboard": "./dist/ReplyKeyboard.js",
      "./CallbackData": "./dist/CallbackData.js"
    }
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.98"
  },
  "scripts": {
    "telegram:generate": "node scripts/generate-telegram.ts",
    "telegram:check": "node scripts/check-generated.ts",
    "build": "tsc -b ../../tsconfig.packages.json && node scripts/copy-telegram-runtime.ts",
    "check": "tsc -b ../../tsconfig.json --pretty false",
    "test": "vitest run --root ../..",
    "test:bun": "bun test test/Telegram.test.ts test/TelegramError.test.ts",
    "check:package": "node scripts/check-package.ts",
    "prepublishOnly": "node scripts/approve-photon-publication.ts"
  }
}
