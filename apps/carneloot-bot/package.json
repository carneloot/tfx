{
	"name": "carneloot-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b ../../tsconfig.packages.json",
		"check": "tsc -b ../../tsconfig.json --pretty false",
		"test": "vitest run --root ../.. apps/carneloot-bot/test",
		"test:integration": "vitest run --root ../.. --config vitest.integration.config.ts apps/carneloot-bot/test",
		"migrations:generate": "node scripts/generate-migration-artifacts.ts",
		"migrations:check": "node scripts/generate-migration-artifacts.ts --check",
		"demo": "fnox exec -- bun src/bin.ts",
		"start": "pnpm demo",
		"demo:test": "bun src/demo-test.ts",
		"import:legacy": "bun src/importer-bin.ts",
		"cloudflare:deploy": "alchemy deploy --stage production",
		"cloudflare:migrate": "node scripts/migrate-cloudflare.ts",
		"cloudflare:webhook": "node scripts/register-cloudflare-webhook.ts"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.6",
		"@effect/sql-pg": "4.0.6",
		"@libsql/client": "0.15.15",
		"@tfx/postgres": "workspace:^",
		"@tfx/postgres-migrator": "workspace:^",
		"effect": "4.0.6",
		"tfx": "workspace:^"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.84",
		"@cloudflare/workers-types": "5.20261012.1",
		"@effect/platform-node": "4.0.6",
		"@testcontainers/postgresql": "11.10.0",
		"alchemy": "2.0.0-beta.84",
		"esbuild": "0.28.2",
		"miniflare": "4.20260730.0"
	},
	"engines": {
		"bun": "1.3.14",
		"node": ">=24 <25"
	}
}
