{
	"name": "carneloot-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b ../../tsconfig.packages.json",
		"check": "tsc -b ../../tsconfig.json --pretty false",
		"test": "vitest run --root ../.. apps/carneloot-bot/test",
		"test:integration": "vitest run --root ../.. --config vitest.integration.config.ts apps/carneloot-bot/test/*.integration.test.ts",
		"demo": "fnox exec -- bun src/bin.ts",
		"start": "pnpm demo",
		"demo:test": "bun src/demo-test.ts"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.0-beta.98",
		"@effect/sql-pg": "4.0.0-beta.98",
		"@tfx/postgres": "workspace:^",
		"effect": "4.0.0-beta.98",
		"tfx": "workspace:^"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.0-beta.98",
		"@testcontainers/postgresql": "11.10.0"
	},
	"engines": {
		"bun": "1.3.14",
		"node": ">=24 <25"
	}
}
