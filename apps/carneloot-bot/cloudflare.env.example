# Copy to .env.cloudflare, which is gitignored. Supply secrets through your
# secret manager, not source control. Alchemy reads this with --env-file.
BOT_TOKEN=
BOT_USERNAME=
# Optional comma-separated usernames. Owner must have started the bot.
TELEGRAM_FORWARD_USERNAMES=
# Required with a nonempty allowlist; omit entirely when unused.
# OWNER_TELEGRAM_ID=123456789
# Generate at least 32 URL-safe characters; do not reuse the bot token.
WEBHOOK_SECRET=
# Place application and TFX tables in the shared production schema.
TFX_POSTGRES_SCHEMA=carnebot
TFX_POSTGRES_TABLE_PREFIX=carneloot_
# Existing PlanetScale Postgres database and branch. Alchemy creates the
# Worker role and configures Hyperdrive from its credentials.
PLANETSCALE_DATABASE=
PLANETSCALE_BRANCH=main
# Operator-only direct PostgreSQL URL. Use the PlanetScale default postgres
# role (port 5432) for schema migrations and the legacy import; neither value
# is bound to the Worker.
DATABASE_URL=
WORKER_URL=
